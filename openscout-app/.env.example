# Core app
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI providers
# Use either a comma-separated list or indexed variables. Single-key envs still work as fallback.
GROQ_API_KEYS=your_groq_api_key_primary,your_groq_api_key_backup
# GROQ_API_KEY_1=your_groq_api_key_primary
# GROQ_API_KEY_2=your_groq_api_key_backup
# GROQ_API_KEY=your_groq_api_key_primary

OPENAI_API_KEYS=your_openai_api_key_primary,your_openai_api_key_backup
# OPENAI_API_KEY_1=your_openai_api_key_primary
# OPENAI_API_KEY_2=your_openai_api_key_backup
# OPENAI_API_KEY=your_openai_api_key_primary

GOOGLE_CLOUD_TTS_API_KEYS=your_google_tts_api_key_primary,your_google_tts_api_key_backup
# GOOGLE_CLOUD_TTS_API_KEY_1=your_google_tts_api_key_primary
# GOOGLE_CLOUD_TTS_API_KEY_2=your_google_tts_api_key_backup
# GOOGLE_CLOUD_TTS_API_KEY=your_google_tts_api_key_primary

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CANDIDATE_PLUS_PRICE_ID=price_candidate_plus
STRIPE_CANDIDATE_PRO_PRICE_ID=price_candidate_pro
STRIPE_EMPLOYER_GROWTH_PRICE_ID=price_employer_growth
STRIPE_EMPLOYER_SCALE_PRICE_ID=price_employer_scale

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Optional monitoring / analytics
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CHECKOUT_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION_LABEL=
