[
  {
    "id": "TC001",
    "title": "Register a new account successfully and reach email confirmation page",
    "description": "Verifies a user can submit the registration form with valid email/password and is guided to confirm their email.",
    "category": "User Registration",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /register"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Register\" is visible"
      },
      {
        "type": "action",
        "description": "Type \"new.user.e2e+001@example.com\" into the email field"
      },
      {
        "type": "action",
        "description": "Type \"ValidPassw0rd!\" into the password field"
      },
      {
        "type": "action",
        "description": "Click on the \"Create account\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Check your email\" is visible"
      },
      {
        "type": "action",
        "description": "Click on the \"Go to email confirmation\" link"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/confirm-email\""
      }
    ]
  },
